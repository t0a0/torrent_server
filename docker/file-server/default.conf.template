server {
    listen 8081;
    server_name _;

    root /srv/downloads;
    autoindex on;
    autoindex_exact_size off;
    autoindex_localtime on;

    location / {
        secure_link $arg_sig,$arg_expires;
        secure_link_md5 "$secure_link_expires$uri$arg_nonce ${DOWNLOAD_LINK_SECRET}";

        if ($secure_link = "") {
            return 403;
        }

        if ($secure_link = "0") {
            return 410;
        }

        try_files $uri $uri/ =404;
    }
}
