TELEGRAM_BOT_TOKEN=<my_bot_token_here>
BOT_OWNER_USER_ID=<my_user_id>

# Telegram API credentials from https://my.telegram.org (App api_id / api_hash).
# The bot speaks MTProto (Telethon), which requires these in addition to the bot token.
TELEGRAM_API_ID=<my_api_id>
TELEGRAM_API_HASH=<my_api_hash>

# Optional: initial MTProto proxy used to reach Telegram when it is blocked. Seeds the
# proxy store (/auth/proxies.json) on first boot only; after that the store (editable
# from the admin page) is the source of truth. Accepts a tg://proxy?server=..&port=..&secret=..
# link, an https://t.me/proxy?.. link, host:port:secret, socks5://host:port, or "direct".
# Multiple entries (comma- or newline-separated) enable automatic failover.
TELEGRAM_MTPROXY=
# Where Telethon persists its session (avoids re-doing the auth handshake each restart).
TELEGRAM_SESSION_PATH=/auth/bot.session

# Proxy admin web page (optional). Leave the credentials blank to disable the page.
# The port is published on 127.0.0.1 only (see docker-compose.yml), so it is reached
# through the reverse proxy already serving your other subdomains (which terminates
# HTTPS) and is never exposed as plaintext on the public IP. The password must be long
# (>= 16 chars) since it is a reusable credential.
ADMIN_WEB_USERNAME=
ADMIN_WEB_PASSWORD=
ADMIN_WEB_PORT=8082

QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USERNAME=<qbit_admin_username>
QBITTORRENT_PASSWORD=<qbit_admin_password>

TORRENT_INPUT_TMP_DIR=tmp/torrent_inputs
AUTH_DB_PATH=/auth/auth.db
ACTIVE_DOWNLOADS_ROOT=/downloads/active_downloads
FINISHED_DOWNLOADS_ROOT=/downloads/finished_downloads
# Broader root qBittorrent saves into. Torrents queued directly via the qBittorrent
# Web UI (which save outside ACTIVE_DOWNLOADS_ROOT) are swept up from here and moved
# under FINISHED_DOWNLOADS_ROOT/<BOT_OWNER_USER_ID>/.
DOWNLOADS_ROOT=/downloads
DOWNLOAD_RECORDS_DB_PATH=/downloads/download_records.db
FINISHED_DOWNLOAD_RETENTION_DAYS=7

HFS_BASE_URL=http://localhost:8081
DOWNLOAD_LINK_SECRET=replace_with_long_random_secret
DOWNLOAD_LINK_TTL_HOURS=24

