# Telegram bot credentials
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_ALLOWED_USER_IDS=123456789

# qBittorrent internal API access (service-only network)
QBITTORRENT_BASE_URL=http://qbittorrent:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=change-me
QBITTORRENT_VERIFY_CERTIFICATE=false
QBITTORRENT_TZ=Europe/Berlin

# App persistence and link-token settings
SQLITE_PATH=/app/data/torrent_server.db
DOWNLOAD_BASE_URL=https://downloads.example.com
DOWNLOAD_TOKEN_SECRET=replace-with-long-random-secret
DOWNLOAD_TOKEN_TTL_SECONDS=3600
